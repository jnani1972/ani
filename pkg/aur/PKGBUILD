# Maintainer: jnani1972 <https://github.com/jnani1972>
pkgname=ani
pkgver=0.10.8
pkgrel=1
pkgdesc="Fast code intelligence engine for AI coding agents — single static binary MCP server"
arch=('x86_64')
url="https://github.com/jnani1972/ani"
license=('MIT')
provides=("$pkgname")
conflicts=("$pkgname")

source_x86_64=("${pkgname}-${pkgver}-linux-amd64.tar.gz::https://github.com/jnani1972/ani/releases/download/v${pkgver}/ani-linux-amd64.tar.gz")

sha256sums_x86_64=('ba8e64111e2cebe15dbe8697d28cdc69abd4098360e1877d4ee447aa912dd034')

package() {
    install -Dm755 "${srcdir}/ani" \
        "${pkgdir}/usr/bin/ani"
    install -Dm644 "${srcdir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    # Third-party attribution bundle (present in archives since v0.8.1)
    if [ -f "${srcdir}/THIRD_PARTY_NOTICES.md" ]; then
        install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" \
            "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
    fi
}
